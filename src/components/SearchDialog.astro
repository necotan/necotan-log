---
import { X } from '@lucide/astro';
import SearchPanel from './SearchPanel.astro';
---

<dialog
  id="search-dialog"
  aria-label="サイト内検索"
  class="mx-auto mt-[12vh] h-fit max-h-[76vh] w-full max-w-2xl rounded-2xl border border-border bg-bg p-0 text-fg backdrop:bg-black/40 backdrop:backdrop-blur-sm open:flex open:flex-col"
>
  <SearchPanel variant="dialog">
    <button
      slot="actions"
      type="button"
      data-search-close
      aria-label="検索を閉じる"
      class="rounded-full p-2 text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-fg"
    >
      <X class="size-5" />
    </button>
  </SearchPanel>
</dialog>

<script>
  import { createSearch, loadPagefind } from '../lib/search';

  const dialog = document.getElementById('search-dialog');
  const search = dialog ? createSearch(dialog) : null;
  const desktopQuery = matchMedia('(min-width: 48rem)');
  let lastTrigger: HTMLElement | null = null;

  function openSearch(trigger: HTMLElement | null): void {
    if (!(dialog instanceof HTMLDialogElement) || dialog.open || !search) return;
    lastTrigger = trigger;
    dialog.showModal();
    document.body.classList.add('overflow-hidden');
    search.input.focus();
    search.input.select();
    void loadPagefind();
  }

  function closeSearch(): void {
    if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
  }

  document.querySelectorAll<HTMLElement>('[data-search-open]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      if (!desktopQuery.matches) return;
      event.preventDefault();
      openSearch(trigger);
    });
  });

  dialog?.querySelector('[data-search-close]')?.addEventListener('click', closeSearch);

  dialog?.addEventListener('close', () => {
    document.body.classList.remove('overflow-hidden');
    lastTrigger?.focus({ preventScroll: true });
  });

  // パネル外(::backdrop)のクリックはdialog自身へのクリックとして届く
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeSearch();
  });

  document.addEventListener('keydown', (event) => {
    if (!desktopQuery.matches) return;
    const target = event.target;
    const isTyping =
      target instanceof HTMLElement && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName));
    const isShortcut = (event.key === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !isTyping);
    if (!isShortcut) return;
    event.preventDefault();
    openSearch(document.querySelector<HTMLElement>('[data-search-open]'));
  });

  // bfcache復元時にダイアログが開いたまま残るのを防ぐ
  // 入力欄はブラウザによって空に戻るが結果リストは残るため、両方を空にして食い違いをなくす
  window.addEventListener('pageshow', () => {
    closeSearch();
    if (!search) return;
    search.input.value = '';
    void search.run('');
  });
</script>
