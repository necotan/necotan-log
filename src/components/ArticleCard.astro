---
import { Image } from 'astro:assets';
import { ImageOff } from '@lucide/astro';
import { categoryLabels, type Category } from '../lib/categories';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  category: Category;
  heroImage?: string;
}

const { href, title, description, pubDate, category, heroImage } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article>
  <a href={href} class="group block">
    <div class="relative aspect-video overflow-hidden rounded-lg border border-border bg-bg-subtle">
      {
        heroImage ? (
          <Image
            src={heroImage}
            inferSize
            alt=""
            class="card-hero-image h-full w-full object-cover group-hover:scale-105"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center bg-bg-subtle">
            <ImageOff class="size-8 text-fg-muted" />
          </div>
        )
      }
    </div>

    <h3 class="mt-3 line-clamp-2 text-base font-semibold text-fg">
      <span class="card-title-underline">{title}</span>
    </h3>
    <p class="mt-1 line-clamp-2 text-sm text-fg-muted">{description}</p>
    <div class="mt-2 flex items-center gap-2 text-xs text-fg-muted">
      <span class="rounded-full bg-fg px-2 py-0.5 font-medium text-bg">{categoryLabels[category]}</span>
      <span aria-hidden="true">/</span>
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
  </a>
</article>

<style>
  /* Tailwindのscale-*はtransformではなくCSSのscaleプロパティを直接変更するため、scaleを対象にtransitionを指定する */
  .card-hero-image {
    transition: scale 0.3s ease-out !important;
  }

  /* 下線をbackground-imageで描画し、hover時にbackground-sizeをアニメーションさせて左から右にイージングで伸ばす */
  .card-title-underline {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.35s ease-out;
  }

  @media (hover: hover) {
    .group:hover .card-title-underline {
      background-size: 100% 1px;
    }
  }
</style>
