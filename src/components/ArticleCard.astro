---
import { Image } from 'astro:assets';
import { ImageOff } from '@lucide/astro';
import { categoryLabels, type Category } from '../lib/categories';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  category: Category;
  heroImage?: string;
  /** ページのh1の直下に並べるなら2、記事末尾のRelatedのようにh2の下に並べるなら3 */
  headingLevel?: 2 | 3;
}

const { href, title, description, pubDate, category, heroImage, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article>
  {/* 背景は無いが、フォーカス枠を画像と同じ角丸にするためrounded-lgを付ける */}
  <a href={href} class="group block rounded-lg">
    <div class="relative aspect-video overflow-hidden rounded-lg bg-surface">
      {
        heroImage ? (
          <Image
            src={heroImage}
            inferSize
            alt=""
            class="card-hero-image h-full w-full object-cover group-hover:scale-105"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center bg-surface">
            <ImageOff class="size-8 text-fg-muted" />
          </div>
        )
      }
    </div>

    <Heading class="mt-3 line-clamp-2 text-base font-semibold text-fg">
      <span class="card-title-underline">{title}</span>
    </Heading>
    <p class="mt-1 line-clamp-2 text-xs text-fg-muted">{description}</p>
    <div class="mt-2 flex items-center gap-2 text-xs text-fg-muted">
      {/* カード全体が1つのリンクのため、カテゴリだけ押せるように見えないよう塗りを付けない */}
      <span class="font-medium">{categoryLabels[category]}</span>
      <span aria-hidden="true">/</span>
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
  </a>
</article>

<style>
  @reference "../styles/global.css";

  /* Tailwindのscale-*はtransformではなくCSSのscaleプロパティを直接変更するため、scaleを対象にtransitionを指定する */
  .card-hero-image {
    transition: scale 0.3s ease-out !important;
  }

  .card-title-underline {
    @apply animated-underline;
  }

  @media (hover: hover) {
    .group:hover .card-title-underline {
      --underline-opacity: 1;
    }
  }
</style>
