---
---

<div
  id="image-viewer"
  class="fixed inset-0 z-50 hidden bg-bg"
  role="dialog"
  aria-modal="true"
  aria-label="画像ビューア"
>
  <div id="image-viewer-track" class="image-viewer-track flex h-full w-full snap-x snap-mandatory overflow-x-auto overscroll-x-contain">
  </div>

  <div class="pointer-events-none absolute inset-x-0 top-0 flex items-center justify-center px-4 py-4">
    <span
      id="image-viewer-counter"
      class="rounded-full bg-fg/10 px-3 py-1 text-sm font-medium text-fg backdrop-blur-sm"
    >
      1 / 1
    </span>
    <button
      id="image-viewer-close"
      type="button"
      aria-label="閉じる"
      class="pointer-events-auto absolute right-4 top-1/2 flex size-9 -translate-y-1/2 items-center justify-center rounded-full bg-fg/10 text-fg backdrop-blur-sm hover:bg-fg/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <button
    id="image-viewer-prev"
    type="button"
    aria-label="前の画像"
    class="absolute left-4 top-1/2 hidden size-10 -translate-y-1/2 items-center justify-center rounded-full bg-fg/10 text-fg backdrop-blur-sm hover:bg-fg/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg md:flex"
  >
    <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m15 18-6-6 6-6" />
    </svg>
  </button>
  <button
    id="image-viewer-next"
    type="button"
    aria-label="次の画像"
    class="absolute right-4 top-1/2 hidden size-10 -translate-y-1/2 items-center justify-center rounded-full bg-fg/10 text-fg backdrop-blur-sm hover:bg-fg/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg md:flex"
  >
    <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m9 18 6-6-6-6" />
    </svg>
  </button>
</div>

<style>
  .image-viewer-track {
    scrollbar-width: none;
  }
  .image-viewer-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  interface ViewerImage {
    src: string;
    alt: string;
  }

  const viewer = document.getElementById('image-viewer');
  const track = document.getElementById('image-viewer-track');
  const counter = document.getElementById('image-viewer-counter');
  const closeButton = document.getElementById('image-viewer-close');
  const prevButton = document.getElementById('image-viewer-prev');
  const nextButton = document.getElementById('image-viewer-next');

  let images: ViewerImage[] = [];
  let currentIndex = 0;
  let isProgrammaticScroll = false;
  let settleTimeout: ReturnType<typeof setTimeout> | undefined;
  let scrollFrame: number | null = null;

  function buildSlides(): void {
    if (!track) return;
    track.innerHTML = '';
    images.forEach((image) => {
      const slide = document.createElement('div');
      slide.className = 'flex h-full w-full shrink-0 snap-center items-center justify-center px-4 py-16 md:px-20';
      const img = document.createElement('img');
      img.src = image.src;
      img.alt = image.alt;
      img.className = 'max-h-full max-w-full object-contain';
      slide.appendChild(img);
      slide.addEventListener('click', (event) => {
        if (event.target === slide) closeViewer();
      });
      track.appendChild(slide);
    });
  }

  function updateUI(): void {
    if (counter) counter.textContent = `${currentIndex + 1} / ${images.length}`;
    prevButton?.classList.toggle('invisible', currentIndex === 0);
    nextButton?.classList.toggle('invisible', currentIndex >= images.length - 1);
  }

  function scrollToIndex(index: number, behavior: ScrollBehavior): void {
    if (!track) return;
    isProgrammaticScroll = true;
    track.scrollTo({ left: index * track.clientWidth, behavior });
    if (settleTimeout) clearTimeout(settleTimeout);
    settleTimeout = setTimeout(
      () => {
        isProgrammaticScroll = false;
      },
      behavior === 'smooth' ? 500 : 50
    );
  }

  function openViewer(index: number): void {
    if (!viewer) return;
    currentIndex = index;
    viewer.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    updateUI();
    scrollToIndex(index, 'instant');
  }

  function closeViewer(): void {
    if (!viewer) return;
    viewer.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  function goTo(index: number): void {
    if (index < 0 || index >= images.length || index === currentIndex) return;
    currentIndex = index;
    scrollToIndex(index, 'smooth');
    updateUI();
  }

  // 記事本文内の画像を収集してビューア対象にする
  const articleImages = Array.from(document.querySelectorAll<HTMLImageElement>('.article-body img'));
  images = articleImages.map((img) => ({ src: img.currentSrc || img.src, alt: img.alt }));
  buildSlides();

  articleImages.forEach((img, index) => {
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', `${img.alt || '画像'}を拡大表示`);

    img.addEventListener('click', () => openViewer(index));
    img.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      openViewer(index);
    });
  });

  closeButton?.addEventListener('click', closeViewer);
  prevButton?.addEventListener('click', () => goTo(currentIndex - 1));
  nextButton?.addEventListener('click', () => goTo(currentIndex + 1));

  document.addEventListener('keydown', (event) => {
    if (viewer?.classList.contains('hidden')) return;
    if (event.key === 'Escape') {
      closeViewer();
      return;
    }
    if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
    // ブラウザ標準の横スクロールと二重に動いて複数枚飛ぶのを防ぐ
    event.preventDefault();
    goTo(event.key === 'ArrowRight' ? currentIndex + 1 : currentIndex - 1);
  });

  // 手動の横スクロールに応じてカウンターと矢印ボタンを更新する
  track?.addEventListener(
    'scroll',
    () => {
      if (scrollFrame !== null) return;
      scrollFrame = requestAnimationFrame(() => {
        scrollFrame = null;
        if (!track || isProgrammaticScroll) return;
        const slideWidth = track.clientWidth;
        if (slideWidth === 0) return;
        const index = Math.round(track.scrollLeft / slideWidth);
        if (index !== currentIndex && index >= 0 && index < images.length) {
          currentIndex = index;
          updateUI();
        }
      });
    },
    { passive: true }
  );

  window.addEventListener('resize', () => {
    if (viewer?.classList.contains('hidden')) return;
    scrollToIndex(currentIndex, 'instant');
  });
</script>
