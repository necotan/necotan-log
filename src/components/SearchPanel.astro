---
import { Search } from '@lucide/astro';
---

<form role="search" data-search-form class="flex items-center gap-3 border-b border-border py-3">
  <Search class="size-4 shrink-0 text-fg-muted" aria-hidden="true" />
  <input
    data-search-input
    type="search"
    enterkeyhint="search"
    autocomplete="off"
    spellcheck="false"
    placeholder="Search posts…"
    aria-label="検索キーワード"
    class="search-input min-w-0 flex-1 bg-transparent py-1.5 text-base text-fg placeholder:text-fg-muted focus:outline-none"
  />
  <button
    type="button"
    data-search-clear
    class="hidden shrink-0 rounded-md px-2 py-1 text-xs text-fg-muted hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-fg"
  >
    Clear
  </button>
</form>

<div data-search-empty class="pt-[20svh] pb-16 text-center md:pt-24">
  <p class="text-sm font-medium text-fg">Search the log</p>
  <p class="mt-1.5 text-sm text-fg-muted">Titles, tags, and everything in between</p>
</div>
<div data-search-no-results class="hidden pt-[20svh] pb-16 text-center md:pt-24">
  <p class="text-sm font-medium text-fg">No results</p>
  <p class="mt-1.5 text-sm text-fg-muted">Try a different or shorter word</p>
</div>
<p data-search-status class="pt-4 text-xs text-fg-muted empty:hidden" aria-live="polite"></p>
<ul data-search-results class="flex flex-col py-2"></ul>

<template data-search-result-template>
  <li>
    <a class="-mx-3 flex gap-4 rounded-lg px-3 py-3 hover:bg-fg/5 focus-visible:bg-fg/5 focus-visible:outline-none">
      <span class="search-result-thumb aspect-video w-24 shrink-0 self-start overflow-hidden rounded-md bg-bg-subtle md:w-32">
        <img alt="" loading="lazy" class="size-full object-cover" />
      </span>
      <span class="flex min-w-0 flex-1 flex-col gap-1">
        <span class="search-result-meta text-xs text-fg-muted"></span>
        <span class="search-result-title line-clamp-2 text-sm font-semibold text-fg"></span>
        <span class="search-result-excerpt line-clamp-2 text-xs leading-relaxed text-fg-muted"></span>
      </span>
    </a>
  </li>
</template>

<style>
  .search-input::-webkit-search-cancel-button {
    appearance: none;
  }

  .search-result-excerpt :global(mark) {
    background: transparent;
    color: var(--fg);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
