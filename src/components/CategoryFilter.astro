---
import { categoryFilters } from '../lib/categories';

interface Props {
  activeHref: string;
}

const { activeHref } = Astro.props;
---

<nav class="flex flex-wrap gap-2">
  {
    categoryFilters.map((item) => (
      <a
        href={item.href}
        class:list={[
          'pill px-4 py-1.5 text-sm',
          item.href === activeHref ? 'pill-active font-semibold' : 'pill-default font-medium',
        ]}
        aria-current={item.href === activeHref ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))
  }
</nav>
