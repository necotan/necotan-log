---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  variant: 'desktop' | 'mobile';
}

const { headings, variant } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 0 &&
    (variant === 'desktop' ? (
      <nav aria-label="目次" class="hidden lg:sticky lg:top-24 lg:block">
        <p class="text-sm font-semibold text-fg">目次</p>
        <ul class="mt-3 space-y-2 border-l border-border pl-4 text-sm">
          {items.map((heading) => (
            <li class:list={[heading.depth === 3 && 'pl-4']}>
              <a href={`#${heading.slug}`} class="text-fg-muted transition-colors hover:text-fg">
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <details class="mt-8 mb-8 rounded-lg border border-border p-4 lg:hidden">
        <summary class="cursor-pointer text-sm font-semibold text-fg">目次</summary>
        <ul class="mt-3 space-y-2 text-sm">
          {items.map((heading) => (
            <li class:list={[heading.depth === 3 && 'pl-4']}>
              <a href={`#${heading.slug}`} class="text-fg-muted transition-colors hover:text-fg">
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))
}
