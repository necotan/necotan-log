---
import { ChevronDown } from '@lucide/astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  variant: 'desktop' | 'mobile';
}

const { headings, variant } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 0 &&
    (variant === 'desktop' ? (
      <nav aria-label="TOC" class="hidden lg:sticky lg:top-24 lg:block">
        <p class="text-sm font-semibold text-fg">TOC</p>
        <ul class="mt-3 space-y-2 border-l border-border pl-4 text-sm">
          {items.map((heading) => (
            <li class:list={[heading.depth === 3 && 'pl-4']}>
              <a
                href={`#${heading.slug}`}
                data-toc-link
                data-slug={heading.slug}
                class="flex items-center gap-2 text-fg-muted transition-colors hover:text-fg"
              >
                <span data-toc-dot class="size-1.5 shrink-0 rounded-full border border-border transition-colors" aria-hidden="true" />
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <details class="toc-details mt-8 mb-8 rounded-lg border border-border p-4 lg:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-fg [&::-webkit-details-marker]:hidden">
          TOC
          <ChevronDown class="toc-chevron size-4 text-fg-muted transition-transform duration-300" aria-hidden="true" />
        </summary>
        <div class="toc-content">
          <ul class="mt-3 space-y-2 text-sm">
            {items.map((heading) => (
              <li class:list={[heading.depth === 3 && 'pl-4']}>
                <a href={`#${heading.slug}`} class="text-fg-muted transition-colors hover:text-fg">
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    ))
}

<script>
  // detailsはopen属性を外すと即座に非表示になりCSSのtransitionが効かないため、WAAPIで高さをアニメーションし、閉じる時はアニメーション完了後にopenを外す
  // 目標の高さはopen属性を一時的に切り替えて実測する(足し算で求めるとpadding/marginの分ズレる)
  class TocAccordion {
    private readonly details: HTMLDetailsElement;
    private readonly summary: HTMLElement;
    private readonly chevron: HTMLElement | null;
    private animation: Animation | null = null;
    private isClosing = false;
    private isExpanding = false;

    constructor(details: HTMLDetailsElement) {
      this.details = details;
      this.summary = details.querySelector('summary')!;
      this.chevron = details.querySelector('.toc-chevron');
      this.summary.addEventListener('click', (event) => this.onClick(event));
    }

    private onClick(event: MouseEvent) {
      event.preventDefault();
      this.details.style.overflow = 'hidden';

      if (this.isClosing || !this.details.open) {
        this.open();
      } else if (this.isExpanding || this.details.open) {
        this.shrink();
      }
    }

    private shrink() {
      this.isClosing = true;
      this.chevron?.classList.remove('rotate-180');

      const startHeight = `${this.details.offsetHeight}px`;
      this.details.open = false;
      const endHeight = `${this.details.offsetHeight}px`;
      this.details.open = true;
      this.details.style.height = startHeight;

      this.animation?.cancel();
      this.animation = this.details.animate({ height: [startHeight, endHeight] }, { duration: 250, easing: 'ease' });
      this.animation.onfinish = () => this.onAnimationFinish(false);
      this.animation.oncancel = () => {
        this.isClosing = false;
      };
    }

    private open() {
      this.details.style.height = `${this.details.offsetHeight}px`;
      this.details.open = true;
      this.chevron?.classList.add('rotate-180');
      requestAnimationFrame(() => this.expand());
    }

    private expand() {
      this.isExpanding = true;
      const startHeight = `${this.details.offsetHeight}px`;
      this.details.style.height = '';
      const endHeight = `${this.details.offsetHeight}px`;
      this.details.style.height = startHeight;

      this.animation?.cancel();
      this.animation = this.details.animate({ height: [startHeight, endHeight] }, { duration: 250, easing: 'ease' });
      this.animation.onfinish = () => this.onAnimationFinish(true);
      this.animation.oncancel = () => {
        this.isExpanding = false;
      };
    }

    private onAnimationFinish(open: boolean) {
      this.details.open = open;
      this.animation = null;
      this.isClosing = false;
      this.isExpanding = false;
      this.details.style.height = '';
      this.details.style.overflow = '';
    }
  }

  document.querySelectorAll<HTMLDetailsElement>('.toc-details').forEach((details) => new TocAccordion(details));

  // 見出しが画面上部30%圏内に入ったらTOC側のドットと文字色を現在地としてハイライトする
  class TocScrollSpy {
    private readonly links: HTMLAnchorElement[];
    private activeSlug: string | null = null;

    constructor(links: HTMLAnchorElement[]) {
      this.links = links;
    }

    setActive(slug: string) {
      if (slug === this.activeSlug) return;
      this.activeSlug = slug;

      for (const link of this.links) {
        const isActive = link.dataset.slug === slug;
        link.classList.toggle('text-fg', isActive);
        link.classList.toggle('text-fg-muted', !isActive);

        const dot = link.querySelector<HTMLElement>('[data-toc-dot]');
        dot?.classList.toggle('bg-fg', isActive);
        dot?.classList.toggle('border-fg', isActive);
        dot?.classList.toggle('border-border', !isActive);
      }
    }
  }

  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const headingElements = tocLinks
    .map((link) => (link.dataset.slug ? document.getElementById(link.dataset.slug) : null))
    .filter((el): el is HTMLElement => el !== null);

  if (tocLinks.length > 0 && headingElements.length > 0) {
    const spy = new TocScrollSpy(tocLinks);
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) spy.setActive(entry.target.id);
        }
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 0 },
    );

    headingElements.forEach((heading) => observer.observe(heading));
  }
</script>
