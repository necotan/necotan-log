---
import { Menu, Moon, Pin, PinOff, Search, Sun } from '@lucide/astro';
import MobileMenu from './MobileMenu.astro';
import SearchDialog from './SearchDialog.astro';
import { navGroups, isNavActive } from '../lib/navigation';
import type { Category } from '../lib/categories';

interface Props {
  /** 記事詳細ページなど、pathnameだけではnav項目と一致しない場合に現在のカテゴリを渡す */
  activeCategory?: Category;
}

const { activeCategory } = Astro.props;
const pathname = Astro.url.pathname;
---

<header id="site-header" class="pinned:sticky pinned:top-0 z-40 px-4 pt-4 md:px-6">
  <div class="glass-panel mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-2xl bg-bg-subtle/60 px-6 py-3 backdrop-blur-md">
    <a href="/" class="text-lg font-semibold tracking-tight text-fg">
      necotan log.
    </a>

    <nav class="hidden items-center gap-4 md:flex">
      {
        navGroups.map((group, groupIndex) => (
          <>
            {groupIndex > 0 && <span class="h-4 w-px scale-x-50 bg-fg" aria-hidden="true" />}
            <div class="flex items-center gap-6">
              {group.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'nav-link text-sm text-fg',
                    isNavActive(pathname, item.href, activeCategory) ? 'nav-link-active font-semibold' : '',
                  ]}
                  aria-current={isNavActive(pathname, item.href, activeCategory) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </div>
          </>
        ))
      }
    </nav>

    <div class="flex items-center">
      <button
        type="button"
        data-search-open
        aria-label="サイト内を検索"
        aria-haspopup="dialog"
        aria-controls="search-dialog"
        class="rounded-lg p-2 text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
      >
        <Search class="size-4" />
      </button>

      <button
        type="button"
        data-pin-toggle
        aria-label="ナビバーを上部に固定する"
        aria-pressed="false"
        class="rounded-lg p-2 text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
      >
        <Pin class="size-4 pinned:hidden" />
        <PinOff class="hidden size-4 pinned:block" />
      </button>

      <button
        type="button"
        data-theme-toggle
        aria-label="ダーク/ライトモードを切り替える"
        aria-pressed="false"
        class="hidden rounded-lg p-2 text-fg md:block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
      >
        <Moon class="size-4 dark:hidden" />
        <Sun class="hidden size-4 dark:block" />
      </button>

      <button
        id="mobile-menu-open"
        type="button"
        aria-label="メニューを開く"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="rounded-lg p-2 text-fg md:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
      >
        <Menu class="size-4" />
      </button>
    </div>
  </div>
</header>

<MobileMenu activeCategory={activeCategory} />
<SearchDialog />

<style>
  @reference "../styles/global.css";

  .nav-link {
    @apply animated-underline;
  }

  .nav-link:hover,
  .nav-link-active {
    --underline-opacity: 1;
  }

  /* bfcache復元直後のhover下線を抑止する(付け外しは下のscriptを参照) */
  :global(html.nav-hover-suppressed) .nav-link:not(.nav-link-active) {
    --underline-opacity: 0;
    transition: none;
  }
</style>

<script>
  const themeToggles = document.querySelectorAll<HTMLElement>('[data-theme-toggle]');
  const pinToggles = document.querySelectorAll<HTMLElement>('[data-pin-toggle]');

  const setPressed = (buttons: NodeListOf<HTMLElement>, pressed: boolean): void => {
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(pressed)));
  };

  setPressed(themeToggles, document.documentElement.classList.contains('dark'));
  setPressed(pinToggles, document.documentElement.classList.contains('header-pinned'));

  const THEME_TRANSITION_MS = 250;
  let themeTransitionTimer: ReturnType<typeof setTimeout> | undefined;

  const applyTheme = (isDark: boolean): void => {
    document.documentElement.classList.add('theme-transition');
    document.documentElement.classList.toggle('dark', isDark);
    document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
    setPressed(themeToggles, isDark);

    clearTimeout(themeTransitionTimer);
    themeTransitionTimer = setTimeout(() => {
      document.documentElement.classList.remove('theme-transition');
    }, THEME_TRANSITION_MS);
  };

  themeToggles.forEach((button) => {
    button.addEventListener('click', () => {
      const isDark = !document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      applyTheme(isDark);
    });
  });

  pinToggles.forEach((button) => {
    button.addEventListener('click', () => {
      const isPinned = document.documentElement.classList.toggle('header-pinned');
      localStorage.setItem('header-pinned', String(isPinned));
      setPressed(pinToggles, isPinned);
    });
  });

  // 戻る/進むでbfcacheから復元されたとき、離脱時にhoverしていたnavリンクの下線が表示されるのを防ぐ
  window.addEventListener('pagehide', () => {
    document.documentElement.classList.add('nav-hover-suppressed');
    window.addEventListener(
      'pointermove',
      () => {
        document.documentElement.classList.remove('nav-hover-suppressed');
      },
      { once: true },
    );
  });

  // 明示的な選択(localStorage)が無い場合のみ、OS側のダーク/ライト切替に追従する
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (localStorage.getItem('theme')) return;
    applyTheme(event.matches);
  });
</script>
