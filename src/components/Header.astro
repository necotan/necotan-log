---
import { Menu, Moon, Search, Sun } from '@lucide/astro';
import MobileMenu from './MobileMenu.astro';
import { navGroups, isNavActive } from '../lib/navigation';
import type { Category } from '../lib/categories';

interface Props {
  /** 記事詳細ページなど、pathnameだけではnav項目と一致しない場合に現在のカテゴリを渡す */
  activeCategory?: Category;
}

const { activeCategory } = Astro.props;
const pathname = Astro.url.pathname;

const iconButtonClass =
  'header-icon-button rounded-lg p-2 text-fg';
---

<header id="site-header" class="px-4 pt-4 md:px-6">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-2xl bg-surface px-6 py-3">
    <a href="/" class="text-lg font-semibold tracking-tight text-fg">
      necotan log.
    </a>

    <nav class="hidden items-center gap-4 md:flex">
      {
        navGroups.map((group, groupIndex) => (
          <>
            {/* 背景色の1px幅は125%表示などで両端が物理ピクセルに丸められ、位置しだいで1pxにも2pxにもなる */}
            {/* 選択中の項目の太字で位置がページごとに変わるため、borderで描いて太さを物理ピクセル単位に揃える */}
            {groupIndex > 0 && <span class="h-4 w-0 border-l border-fg" aria-hidden="true" />}
            <div class="flex items-center gap-6">
              {group.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'nav-link text-sm text-fg',
                    isNavActive(pathname, item.href, activeCategory) ? 'nav-link-active font-semibold' : '',
                  ]}
                  aria-current={isNavActive(pathname, item.href, activeCategory) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </div>
          </>
        ))
      }
    </nav>

    <div class="flex items-center">
      <a
        href="/search/"
        aria-label="サイト内を検索"
        class={iconButtonClass}
      >
        <Search class="size-4" />
      </a>

      <button
        type="button"
        data-theme-toggle
        aria-label="ダーク/ライトモードを切り替える"
        aria-pressed="false"
        class:list={[iconButtonClass, 'hidden md:block']}
      >
        <Moon class="size-4 dark:hidden" />
        <Sun class="hidden size-4 dark:block" />
      </button>

      <button
        id="mobile-menu-open"
        type="button"
        aria-label="メニューを開く"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class:list={[iconButtonClass, 'md:hidden']}
      >
        <Menu class="size-4" />
      </button>
    </div>
  </div>
</header>

<MobileMenu activeCategory={activeCategory} />

<style>
  @reference "../styles/global.css";

  .nav-link {
    @apply animated-underline;
  }

  .nav-link:hover,
  .nav-link-active {
    --underline-opacity: 1;
  }

  /* ボタン自体ではなくアイコンだけを持ち上げ、押せる範囲は動かさない */
  /* lucideのsvgは子コンポーネントの要素でスコープ属性が付かないため:global()で指定する */
  .header-icon-button > :global(svg) {
    transition: translate 0.2s ease-out;
  }

  @media (hover: hover) {
    .header-icon-button:hover > :global(svg) {
      translate: 0 -2px;
    }
  }

  .header-icon-button:active > :global(svg) {
    translate: 0 0;
  }

  /* bfcache復元直後のhover下線とアイコンの浮きを抑止する(付け外しは下のscriptを参照) */
  :global(html.nav-hover-suppressed) .nav-link:not(.nav-link-active) {
    --underline-opacity: 0;
    transition: none;
  }

  :global(html.nav-hover-suppressed) .header-icon-button > :global(svg) {
    translate: none;
    transition: none;
  }
</style>

<script>
  const themeToggles = document.querySelectorAll<HTMLElement>('[data-theme-toggle]');

  const setPressed = (buttons: NodeListOf<HTMLElement>, pressed: boolean): void => {
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(pressed)));
  };

  setPressed(themeToggles, document.documentElement.classList.contains('dark'));

  const THEME_TRANSITION_MS = 250;
  let themeTransitionTimer: ReturnType<typeof setTimeout> | undefined;

  const applyTheme = (isDark: boolean): void => {
    document.documentElement.classList.add('theme-transition');
    document.documentElement.classList.toggle('dark', isDark);
    document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
    setPressed(themeToggles, isDark);

    clearTimeout(themeTransitionTimer);
    themeTransitionTimer = setTimeout(() => {
      document.documentElement.classList.remove('theme-transition');
    }, THEME_TRANSITION_MS);
  };

  themeToggles.forEach((button) => {
    button.addEventListener('click', () => {
      const isDark = !document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      applyTheme(isDark);
    });
  });

  // 戻る/進むでbfcacheから復元されたとき、離脱時にhoverしていたnavリンクの下線やアイコンの浮きが残るのを防ぐ
  window.addEventListener('pagehide', () => {
    document.documentElement.classList.add('nav-hover-suppressed');
    window.addEventListener(
      'pointermove',
      () => {
        document.documentElement.classList.remove('nav-hover-suppressed');
      },
      { once: true },
    );
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target;
    const isTyping =
      target instanceof HTMLElement && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName));
    const isShortcut = (event.key === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !isTyping);
    if (!isShortcut) return;
    event.preventDefault();
    const searchInput = document.querySelector<HTMLInputElement>('#search-page [data-search-input]');
    if (searchInput) {
      searchInput.focus();
      searchInput.select();
    } else {
      location.href = '/search/';
    }
  });

  // 明示的な選択(localStorage)が無い場合のみ、OS側のダーク/ライト切替に追従する
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (localStorage.getItem('theme')) return;
    applyTheme(event.matches);
  });
</script>
