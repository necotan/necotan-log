---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ListHeading from '../components/ListHeading.astro';
import { categoryLabels } from '../lib/categories';
import { serializeJsonLd } from '../lib/jsonLd';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 新しい順に並べてから入れるので、Mapの挿入順のまま年も新しい順になる
const postsByYear = new Map<number, CollectionEntry<'blog'>[]>();
posts.forEach((post) => {
  const year = post.data.pubDate.getFullYear();
  postsByYear.set(year, [...(postsByYear.get(year) ?? []), post]);
});

const formatDate = (date: Date): string => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

const canonicalURL = new URL('/archive/', Astro.site).href;
const homeHref = new URL('/', Astro.site).href;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'necotan log.', item: homeHref },
    { '@type': 'ListItem', position: 2, name: 'Archive', item: canonicalURL },
  ],
};
---

<BaseLayout title="Archive | necotan log." description="necotan log. の全記事を年ごとに並べた一覧">
  <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbJsonLd)} is:inline />
  <section class="mx-auto max-w-6xl px-6 pt-10 pb-16">
    <ListHeading title="Archive" total={posts.length} />

    {
      posts.length > 0 ? (
        <div class="mt-8 flex max-w-3xl flex-col gap-10">
          {Array.from(postsByYear, ([year, yearPosts]) => (
            <section>
              <h2 class="flex items-baseline gap-2 text-lg font-semibold text-fg">
                {year}
                <span class="text-sm font-normal text-fg-muted">
                  {yearPosts.length} {yearPosts.length === 1 ? 'post' : 'posts'}
                </span>
              </h2>
              <ul class="mt-2 flex flex-col">
                {yearPosts.map((post) => (
                  <li>
                    <a
                      href={`/blog/${post.id}/`}
                      class="-mx-3 flex items-baseline gap-4 rounded-lg px-3 py-3 hover:bg-surface focus-visible:bg-surface focus-visible:outline-none"
                    >
                      <time
                        datetime={post.data.pubDate.toISOString()}
                        class="w-14 shrink-0 text-sm whitespace-nowrap text-fg-muted tabular-nums"
                      >
                        {formatDate(post.data.pubDate)}
                      </time>
                      <span class="min-w-0 flex-1 text-sm font-semibold text-fg">{post.data.title}</span>
                      <span class="shrink-0 text-xs text-fg-muted">{categoryLabels[post.data.category]}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <p class="mt-6 text-fg-muted">No posts yet</p>
      )
    }
  </section>
</BaseLayout>
