---
import BaseLayout from '../layouts/BaseLayout.astro';
import ListHeading from '../components/ListHeading.astro';
import { serializeJsonLd } from '../lib/jsonLd';
import { getPosts } from '../lib/posts';
import { getTagCounts, tagHref } from '../lib/tags';

const tags = getTagCounts(await getPosts());

const canonicalURL = new URL('/tags/', Astro.site).href;
const homeHref = new URL('/', Astro.site).href;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'necotan log.', item: homeHref },
    { '@type': 'ListItem', position: 2, name: 'Tags', item: canonicalURL },
  ],
};
---

<BaseLayout title="Tags | necotan log." description="necotan log. のタグ一覧">
  <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbJsonLd)} is:inline />
  <section class="mx-auto max-w-6xl px-6 pt-10 pb-16">
    <ListHeading title="Tags" total={tags.length} unit="tag" />

    {
      tags.length > 0 ? (
        <ul class="mt-6 flex flex-wrap gap-2">
          {tags.map(({ tag, count }) => (
            <li>
              {/* 薄い文字色はchip-bgの上だとライトテーマで4.5:1に届かないため、件数もfgのまま太さと大きさで区別する */}
              <a
                href={tagHref(tag)}
                aria-label={`#${tag}、${count}件`}
                class="pill pill-default inline-flex items-baseline gap-1.5 px-4 py-1.5 text-sm font-medium"
              >
                #{tag}
                <span class="text-xs font-normal tabular-nums">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-6 text-fg-muted">No tags yet</p>
      )
    }
  </section>
</BaseLayout>
