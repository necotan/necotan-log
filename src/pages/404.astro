---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 | necotan log." description="Page not found" chrome={false}>
  <div class="flex min-h-screen justify-center bg-bg px-6 pt-24 font-mono text-fg md:items-center md:pt-6">
    <div class="w-full max-w-lg">
      <p><span class="text-fg-muted">$</span> curl -sI https://necotan-log.com<span class="req-path">/this-article</span></p>
      <p class="text-fg-muted opacity-80">HTTP/2 404</p>
      <p class="text-fg-muted opacity-80">content-type: text/html; charset=utf-8</p>

      <p class="mt-6"><span class="text-fg-muted">$</span> git log --oneline --grep="<span class="req-term">this-article</span>"</p>

      <p class="mt-6">
        <span class="text-fg-muted">$</span> <span class="terminal-caret">█</span>
      </p>

      <div class="mt-10 border-t border-border pt-6">
        <p class="text-lg font-semibold text-fg">404 — Page Not Found</p>
        <a href="/" class="mt-4 inline-block text-fg-muted underline underline-offset-2 hover:text-fg">
          Back to Home
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    let path = location.pathname;
    try {
      path = decodeURIComponent(path);
    } catch {
      // 不正なパーセントエンコーディングの場合はそのまま表示する
    }
    const term = path.replace(/^\/|\/$/g, '') || 'home';
    document.querySelectorAll('.req-path').forEach((el) => {
      el.textContent = path;
    });
    document.querySelectorAll('.req-term').forEach((el) => {
      el.textContent = term;
    });
  </script>
</BaseLayout>
